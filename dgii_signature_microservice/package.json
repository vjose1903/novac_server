{
  "name": "@vjose1903/dgii",
  "version": "1.0.0",
  "main": "src/server",
  "scripts": {
    "start:dev": "NODE_OPTIONS='--trace-deprecation' ts-node-dev --respawn --transpile-only -r dotenv/config -r tsconfig-paths/register src/server.ts",
    "clean": "rimraf dist",
    "build:ts": "tsc && tsc-alias",
    "test-function": "node --trace-deprecation -r dotenv/config -r tsconfig-paths/register -r ts-node/register src/utils/test.ts",
    "copy:assets": "node -e \"const fs=require('fs');const path=require('path');fs.mkdirSync('dist/utils',{recursive:true});for(const file of fs.readdirSync('src/utils')){if(/\\.(p12|xml|json)$/.test(file)){fs.copyFileSync(path.join('src/utils',file),path.join('dist/utils',file));}}\"",
    "build": "npm run clean && npm run build:ts && npm run copy:assets",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "@types/big.js": "6.2.2",
    "@vjose1903/dateutils": "1.0.20",
    "big.js": "7.0.1",
    "dgii-ecf": "^1.8.5",
    "express": "^5.2.1",
    "googleapis": "^148.0.0",
    "http": "^0.0.1-security",
    "mime-types": "^3.0.2",
    "node-forge": "^1.4.0",
    "queue": "^7.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/node": "^22.12.0",
    "dotenv": "^16.5.0",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "type": "commonjs"
}
